{
  "name": "sound-shaper",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/unit",
    "brand-art": "python3 -m venv .brand-venv >/dev/null && .brand-venv/bin/pip install --quiet shapely pillow && .brand-venv/bin/python scripts/gen-brand-art.py",
    "store-screenshots": "python3 -m venv .brand-venv >/dev/null && .brand-venv/bin/pip install --quiet pillow && .brand-venv/bin/python store/generate.py",
    "postinstall": "node scripts/apply-patches.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "24.1.1",
    "@react-native-firebase/auth": "24.1.1",
    "@react-native-firebase/crashlytics": "24.1.1",
    "@react-native-firebase/firestore": "24.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.7",
    "expo-apple-authentication": "~57.0.0",
    "expo-application": "~57.0.0",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.2",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.5",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.0",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.3",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "i18n-js": "4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-audio-api": "0.13.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-sortables": "1.9.4",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.0",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "typescript": "~5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.7",
    "@xmldom/xmldom@0.8": "^0.8.15",
    "@xmldom/xmldom@0.9": "^0.9.12",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "browserslist": "^4.29.3",
    "compression": "^1.8.2",
    "js-yaml@4": "^4.3.2",
    "nanoid@3": "^3.3.20",
    "postcss": "^8.5.30",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "expo": {
    "autolinking": {
      "apple": {
        "buildFromSource": [
          "ExpoImage"
        ]
      },
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  }
}
