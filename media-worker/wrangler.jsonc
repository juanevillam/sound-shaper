{
  // Sound Shaper's media Worker: it holds the Cloudinary API secret so the app
  // can delete its own uploads, and proves ownership by the upload PATH alone
  // (see README.md). The same source once served the portfolio's other apps,
  // which is why it is an environment rather than the top level.
  //
  // ALWAYS DEPLOY WITH `--env`:
  //   npx wrangler deploy --env sound-shaper
  //
  // `vars` are NOT inherited from the top level by named environments, and
  // nothing here defines them, so a bare `wrangler deploy` produces a Worker
  // with no FIREBASE_PROJECT_ID — every token then fails `bad-aud` and it
  // deletes nothing. It fails CLOSED, which is the intended shape of that
  // mistake.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "env": {
    "sound-shaper": {
      "name": "sound-shaper-media-worker",
      "vars": {
        "CLOUDINARY_CLOUD_NAME": "juanevillam",
        "FIREBASE_PROJECT_ID": "sound-shaper",
        // Must equal the app's `MEDIA_ROOT` (cloudinary/folders.ts).
        "MEDIA_FOLDER_ROOT": "sound-shaper",
      },
    },
  },
}
