{
  // ONE source, TWO deployments. The apps sit on different Firebase projects,
  // and the ID token's `aud`/`iss` are checked against FIREBASE_PROJECT_ID, so
  // a shared instance could not verify both. Environments give each app its own
  // Worker, its own vars and its own secrets off a single codebase — a second
  // copy of the token verifier is exactly the duplication
  // `scripts/shared-code-audit.mjs` exists to catch.
  //
  // ALWAYS DEPLOY WITH `--env`:
  //   npx wrangler deploy --env topper
  //   npx wrangler deploy --env sound-shaper
  //
  // `vars` are NOT inherited from the top level by named environments, and
  // nothing here defines them, so a bare `wrangler deploy` produces a Worker
  // with no FIREBASE_PROJECT_ID — every token then fails `bad-aud` and it
  // deletes nothing. It fails CLOSED, which is the intended shape of that
  // mistake.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "env": {
    "topper": {
      "name": "topper-media-worker",
      "vars": {
        "CLOUDINARY_CLOUD_NAME": "juanevillam",
        "FIREBASE_PROJECT_ID": "topper-da7db",
        // Must equal the app's `ITEMS_MEDIA_ROOT` (cloudinary/folders.ts).
        "MEDIA_FOLDER_ROOT": "topper/items",
      },
    },
    "sound-shaper": {
      "name": "sound-shaper-media-worker",
      "vars": {
        "CLOUDINARY_CLOUD_NAME": "juanevillam",
        "FIREBASE_PROJECT_ID": "sound-shaper",
        // Must equal the app's `MEDIA_ROOT` (cloudinary/folders.ts).
        "MEDIA_FOLDER_ROOT": "sound-shaper",
      },
    },
  },
}
