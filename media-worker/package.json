{
  "name": "media-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Single-purpose Cloudflare Worker that deletes the authenticated caller's own Cloudinary assets. No other capability.",
  "scripts": {
    "dev": "wrangler dev --env sound-shaper",
    "deploy": "wrangler deploy --env sound-shaper",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.151.1"
  }
}
