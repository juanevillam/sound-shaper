{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@app/*": ["../src/*"],
      "@/*": ["../src/*"],
      "react-native-audio-api": ["./src/shims/audio-api.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
