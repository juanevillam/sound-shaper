rules_version = '2';

// Personal-only rules: the app has zero social surface, so everything under a
// user is readable/writable by that user alone. Songs are a flat library at
// users/{uid}/songs (playlists were dropped 2026-07-19), clips hang off each
// song.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A signed-in user reads any profile but writes only their own — the doc
    // `upsertOwnProfile` creates on sign-in.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isUser(uid);

      // The personal library: owner-only, the path IS the ownership.
      match /songs/{songId} {
        allow read, write: if isUser(uid);

        // Personal replay bookmarks into a song — same ownership.
        match /clips/{clipId} {
          allow read, write: if isUser(uid);
        }
      }

      // The user's own saved sound shapes (EQ + speed + keep-pitch). Global to
      // the account rather than per-song, so they sit beside `songs`.
      match /shapes/{shapeId} {
        allow read, write: if isUser(uid);
      }

      // Earned trophies — private to you, one doc per trophy id holding its
      // `achievedAt`, so awards survive a reinstall.
      match /trophies/{trophyId} {
        allow read: if isUser(uid);
        allow write: if isUser(uid);
      }
    }

  }
}
