rules_version = '2';

// Personal-only rules: the app has zero social surface, so everything under a
// user is readable/writable by that user alone. Songs are a flat library at
// users/{uid}/songs (playlists were dropped 2026-07-19), clips hang off each
// song.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The profile — name, photo, where the add tile sits, the trophy totals —
    // is the owner's alone, like everything under it. It was readable by any
    // signed-in account, a leftover from when the portfolio's apps shared a
    // social model; nothing in this app ever reads another person's doc.
    match /users/{uid} {
      allow read, write: if isUser(uid);

      // The personal library: owner-only, the path IS the ownership.
      match /songs/{songId} {
        allow read, write: if isUser(uid);

        // Personal replay bookmarks into a song — same ownership.
        match /clips/{clipId} {
          allow read, delete: if isUser(uid);
          allow create, update: if isUser(uid)
            && request.resource.data.keys().size() <= 7
            && request.resource.data.startMs is number
            && request.resource.data.endMs is number
            && request.resource.data.startMs >= 0
            && request.resource.data.endMs > request.resource.data.startMs
            && request.resource.data.endMs <= 86400000;
        }
      }

      // LEGACY saved sound shapes (EQ + speed + keep-pitch), global to the
      // account rather than per-song. Nothing has written one since 2026-08-22,
      // when saving a shape was removed; the rule stays so the delete-account
      // sweep can still clear what an early account left behind.
      match /shapes/{shapeId} {
        allow read, write: if isUser(uid);
      }

      // Earned trophies — private to you, one doc per trophy id holding its
      // `achievedAt`, so awards survive a reinstall.
      match /trophies/{trophyId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && request.resource.data.keys().hasOnly(['achievedAt'])
          && request.resource.data.achievedAt is number;
      }
    }

  }
}
