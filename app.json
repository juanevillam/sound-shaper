{
  "expo": {
    "name": "Sound Shaper",
    "slug": "sound-shaper",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "soundshaper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/AppIcon.icon",
      "appleTeamId": "PHLR7X3FGN",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleLocalizations": ["en", "es", "zh"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.juanevillam.soundshaper",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.grostify.soundshaper"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#222222",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.juanevillam.soundshaper",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.714853847469-0vavdv83f8ev7v7pau88ff5ubtavq1l8"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#222222",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "zh"],
            "android": ["en", "es", "zh"]
          }
        }
      ],
      "../../plugins/with-ios-swiftui-link-fix",
      "../../plugins/with-ios-scene-lifecycle",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "react-native-audio-api",
        {
          "androidForegroundService": true,
          "androidFSTypes": ["mediaPlayback"],
          "androidPermissions": [
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.POST_NOTIFICATIONS"
          ],
          "iosBackgroundMode": true
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false,
          "photosPermission": "Sound Shaper uses your photo library so you can set cover art for your sounds."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0088c13d-37ab-482a-9fb1-bc50daf8c5c1"
      }
    },
    "owner": "juanevillam"
  }
}
